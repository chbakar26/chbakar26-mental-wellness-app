@model RegisterRoleViewModel
@{
    ViewData["Title"] = "Participant Registration";
}
<h2>Participant Registration</h2>
<form asp-action="RegisterParticipant" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-2"><label asp-for="FullName"></label><input asp-for="FullName" class="form-control" /></div>
    <div class="mb-2"><label asp-for="Email"></label><input asp-for="Email" class="form-control" /></div>
    <div class="mb-2"><label asp-for="Password"></label><input asp-for="Password" class="form-control" /></div>
    <div class="mb-2"><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" class="form-control" /></div>
    <button class="btn btn-primary" type="submit">Create Participant Account</button>
</form>
<partial name="_ValidationScriptsPartial" />
