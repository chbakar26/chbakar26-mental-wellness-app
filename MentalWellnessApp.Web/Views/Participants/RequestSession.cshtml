@{
    ViewData["Title"] = "Request Session";
}
<h2>Request Session</h2>
<form asp-action="RequestSession" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-2">
        <label class="form-label">Preferred Date/Time</label>
        <input type="datetime-local" name="preferredDateTime" class="form-control" required />
    </div>
    <div class="mb-2">
        <label class="form-label">Notes for counsellor</label>
        <textarea name="participantNotes" class="form-control"></textarea>
    </div>
    <button class="btn btn-primary" type="submit">Submit Request</button>
</form>
