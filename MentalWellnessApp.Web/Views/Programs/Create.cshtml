@model WellnessProgram
@{
    ViewData["Title"] = "Create Program";
}
<h2>Create Program</h2>
<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-2"><label asp-for="Topic"></label><input asp-for="Topic" class="form-control" /></div>
    <div class="mb-2"><label asp-for="Description"></label><textarea asp-for="Description" class="form-control"></textarea></div>
    <div class="mb-2"><label asp-for="AccessibilityLevel"></label><input asp-for="AccessibilityLevel" class="form-control" /></div>
    <div class="mb-2"><label asp-for="StartDate"></label><input asp-for="StartDate" type="date" class="form-control" /></div>
    <div class="mb-2"><label asp-for="EndDate"></label><input asp-for="EndDate" type="date" class="form-control" /></div>
    <button class="btn btn-primary" type="submit">Save</button>
</form>
<partial name="_ValidationScriptsPartial" />
